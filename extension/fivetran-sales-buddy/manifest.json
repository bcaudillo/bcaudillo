{
  "manifest_version": 3,
  "name": "Fivetran Connector Scout",
  "version": "0.1.0",
  "description": "Quick-reference connector intelligence for Fivetran expansion AEs",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://fivetran.com/*", "https://*.fivetran.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://fivetran.com/*", "https://*.fivetran.com/*"],
      "js": ["dom-scanner.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
